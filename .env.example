# Copy this file to .env (in the repo root) and fill in your own key.
# Never commit the real .env: it is listed in .gitignore.

# Portkey key used by every agent (OpenAI SDK pointed at Portkey, model gpt-6-luna)
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: Portkey gateway URL (this is the default)
# PORTKEY_BASE_URL=https://api.portkey.ai/v1
